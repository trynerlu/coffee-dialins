{
  "_comment": "Dial-In App — data contract. Both chats read this before writing. Edit only from the app chat.",
  "_version": "3.3.0",
  "_updated": "2026-10-22",
  "kitIds": [
    "home-espresso",
    "home-pour-over",
    "home-french-press",
    "office-espresso",
    "office-pour-over",
    "office-french-press"
  ],
  "enums": {
    "process": [
      "Washed",
      "Natural",
      "Honey",
      "Anaerobic Natural",
      "Anaerobic Washed",
      "Anaerobic",
      "Carbonic Maceration",
      "Wet-Hulled",
      "Experimental",
      "Blend"
    ],
    "roastLevel": [
      "Light",
      "Medium-Light",
      "Medium",
      "Medium-Dark",
      "Dark"
    ],
    "brewMethods": [
      "Espresso",
      "Pour Over",
      "French Press"
    ],
    "dialStatus": [
      "waiting",
      "dialing",
      "dialed",
      "abandoned"
    ],
    "beanLocation": [
      "shelf",
      "open",
      "frozen",
      "empty"
    ],
    "dialEase": [
      "easy",
      "medium",
      "hard"
    ],
    "dialStability": [
      "stable",
      "unstable"
    ],
    "tags": [
      "interesting",
      "complex",
      "funky",
      "versatile",
      "well responding",
      "good value",
      "good for milk",
      "crowd-pleaser",
      "affogato",
      "my choice",
      "flat",
      "boring",
      "not well responding"
    ]
  },
  "fields": {
    "id": {
      "type": "string",
      "required": true,
      "note": "Format: d-{timestamp}-{slug}, e.g. d-1746921600000-cg-eth01"
    },
    "date": {
      "type": "date",
      "required": true,
      "note": "ISO date YYYY-MM-DD — dial-in date"
    },
    "kitId": {
      "type": "enum",
      "required": false,
      "note": "Optional since v3.2. Set only when a specific kit was dialed; library reviews may leave it empty."
    },
    "coffeeName": {
      "type": "string",
      "required": true
    },
    "roaster": {
      "type": "string",
      "required": false
    },
    "origin": {
      "type": "string",
      "required": false
    },
    "region": {
      "type": "string",
      "required": false
    },
    "process": {
      "type": "enum",
      "required": false,
      "note": "Use the most specific enum value. Blends of mixed process = 'Blend'."
    },
    "roastLevel": {
      "type": "enum",
      "required": false
    },
    "roastDate": {
      "type": "date",
      "required": false,
      "note": "From the bag label (handwritten dates are common, e.g. '10.12.25'). Empty if not visible."
    },
    "brewMethods": {
      "type": "array",
      "required": true,
      "note": "Array of strings from enums.brewMethods"
    },
    "flavorNotes": {
      "type": "string",
      "required": false,
      "note": "Comma-separated keywords e.g. 'Jasmine, lemon, honey'"
    },
    "grindSetting": {
      "type": "string",
      "required": false,
      "note": "String to allow values like '15 (Sculptor) / 21 (Encore)'"
    },
    "grinder": {
      "type": "string",
      "required": false
    },
    "doseIn": {
      "type": "number",
      "required": false,
      "note": "Grams"
    },
    "yieldOut": {
      "type": "number",
      "required": false,
      "note": "Grams (espresso) or grams (pour over — NOT ml)"
    },
    "timeSeconds": {
      "type": "number",
      "required": false,
      "note": "Total time in seconds"
    },
    "temperature": {
      "type": "number",
      "required": false,
      "note": "Celsius"
    },
    "rating": {
      "type": "number",
      "required": false,
      "note": "0–5 in 0.5 steps (e.g. 3.5). 0 = unrated."
    },
    "dialStatus": {
      "type": "enum",
      "required": true,
      "default": "dialed"
    },
    "experimenting": {
      "type": "boolean",
      "required": false,
      "default": false
    },
    "beanLocation": {
      "type": "enum",
      "required": true,
      "default": "empty",
      "note": "Library reviews of finished bags = 'empty'."
    },
    "frozenDate": {
      "type": "date",
      "required": false,
      "note": "ISO date. Set when beanLocation becomes 'frozen'. Empty string if not frozen."
    },
    "thawDate": {
      "type": "date",
      "required": false,
      "note": "ISO date. Set automatically when moving out of frozen. Empty string otherwise."
    },
    "dialEase": {
      "type": "enum",
      "required": false
    },
    "dialStability": {
      "type": "enum",
      "required": false
    },
    "wouldBuy": {
      "type": "boolean",
      "required": false,
      "default": false
    },
    "isChoice": {
      "type": "boolean",
      "required": false,
      "default": false
    },
    "isEarlyEntry": {
      "type": "boolean",
      "required": false,
      "default": false
    },
    "tags": {
      "type": "array",
      "required": false,
      "note": "Array of strings from enums.tags. Empty array if none."
    },
    "filterPours": {
      "type": "array",
      "required": false,
      "note": "Array of {phase:number, targetGrams:number, startSeconds:number}. Cumulative grams. Phase 1 = bloom. Empty array for espresso."
    },
    "coffeeUrl": {
      "type": "string",
      "required": false,
      "note": "Product page on the roaster's site, found by matching the bag label. Primary source for filling gaps."
    },
    "coffeeDescription": {
      "type": "string",
      "required": false
    },
    "notes": {
      "type": "string",
      "required": false
    },
    "review": {
      "type": "string",
      "required": false,
      "note": "v3.2. Lukáš's verdict in 1–3 sentences, written from his dictation. The headline text of the entry."
    },
    "variety": {
      "type": "string",
      "required": false,
      "note": "v3.2. e.g. 'SL28, SL34', 'Heirloom', 'Gesha'. Only if stated by the roaster."
    },
    "producer": {
      "type": "string",
      "required": false,
      "note": "v3.2. Producer/cooperative/washing station. Only if stated by the roaster."
    },
    "farm": {
      "type": "string",
      "required": false,
      "note": "v3.2. Farm name if different from producer."
    },
    "altitude": {
      "type": "string",
      "required": false,
      "note": "v3.2. As stated, e.g. '1900–2100 m'."
    }
  },
  "deprecated_do_not_use": [
    "intendedFor",
    "dialDifficulty",
    "shotStability",
    "roasterUrl",
    "filterBloomGrams",
    "filterBloomSeconds",
    "bagStatus",
    "status"
  ],
  "write_rules": [
    "Write only via tools/dialin_api.py (GitHub API + sha guard). Never PUT dialins.json from a copy you read earlier.",
    "dialins.json is stored as {_appWrittenAt, entries}; the script handles this.",
    "Draft the entry in chat first and wait for Lukáš to confirm before writing.",
    "Bag photos are input only: read every detail on the label, then find the product page online to fill gaps. Never upload or store the photo.",
    "Source priority: bag label > roaster's product page > nothing. If the two disagree, use the label and mention it in the draft.",
    "variety/producer/farm/altitude: only facts from the roaster's own page or bag label — never guessed. Leave empty if unknown.",
    "Unknown dates/values: empty string or 0, never invented.",
    "New coffee = new entry. Same coffee on another kit/brew = separate entry with the same coffeeName + roaster (the app groups them)."
  ],
  "wishlist": {
    "file": "wishlist.json (plain array)",
    "fields": {
      "id": "w-{timestamp}-{slug}",
      "type": "'radar' (roaster/coffee to explore) | 'tasted' (had it somewhere)",
      "roaster": "required",
      "coffeeName": "'' for roaster-level interest",
      "source": "where/how",
      "date": "YYYY-MM-DD or ''",
      "flavorNotes": "",
      "notes": "",
      "url": "",
      "ordered": false,
      "orderedDate": "",
      "dialinId": "",
      "addedDate": "YYYY-MM-DD"
    }
  },
  "push_link_format_fallback": "https://trynerlu.github.io/coffee-dialins/push.html?type=dialin&d=BASE64",
  "base64_python": "base64.urlsafe_b64encode(json.dumps(obj).encode()).decode().rstrip('=')"
}